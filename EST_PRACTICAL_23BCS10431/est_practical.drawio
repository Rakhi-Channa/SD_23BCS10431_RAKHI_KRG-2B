        <mxCell id="1InsdKHyRmnL4WrNLs_7-47" parent="1" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="fanout model" vertex="1">
          <mxGeometry height="30" width="80" x="680" y="585" as="geometry" />
        </mxCell>
        <mxCell id="1InsdKHyRmnL4WrNLs_7-48" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="&lt;b&gt;&lt;u&gt;Problem:&lt;/u&gt;&lt;/b&gt; to generate feed&lt;div&gt;&amp;nbsp;for every user&amp;nbsp;&lt;/div&gt;&lt;div&gt;we have to hit post&amp;nbsp;&lt;/div&gt;&lt;div&gt;DB and follower DB&amp;nbsp;&lt;/div&gt;&lt;div&gt;every time which&amp;nbsp;&lt;/div&gt;&lt;div&gt;will cause latency&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="170" x="560" y="615" as="geometry" />
        </mxCell>
        <mxCell id="1InsdKHyRmnL4WrNLs_7-49" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="&lt;b&gt;&lt;u&gt;solution:&lt;/u&gt;&lt;/b&gt; fanout model&amp;nbsp;&lt;div&gt;fanout push (fanout write) :&lt;/div&gt;&lt;div&gt;&amp;nbsp;for normal users&amp;nbsp;&lt;/div&gt;&lt;div&gt;we will push the&amp;nbsp;&lt;/div&gt;&lt;div&gt;post in the feed of&lt;/div&gt;&lt;div&gt;every follower&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="170" x="710" y="630" as="geometry" />
        </mxCell>
        <mxCell id="1InsdKHyRmnL4WrNLs_7-50" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;" value="&lt;b&gt;&lt;u&gt;celebrity problem&lt;/u&gt;&lt;/b&gt;&amp;nbsp; :&amp;nbsp;&lt;div&gt;for&amp;nbsp; user with millions&amp;nbsp;&lt;/div&gt;&lt;div&gt;of followers, we cannot&lt;/div&gt;&lt;div&gt;&amp;nbsp;push in every followers&lt;/div&gt;&lt;div&gt;&amp;nbsp;feed so , here we wil&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;l&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;use fanout pull model&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;(fanout read) which will get&lt;/div&gt;&lt;div&gt;&amp;nbsp;the post on demand&amp;nbsp;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="170" x="840" y="600" as="geometry" />
        </mxCell>
